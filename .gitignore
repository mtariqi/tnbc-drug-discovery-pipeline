# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environments
.venv/
venv/
*.env

# Real third-party BULK data only (by file type, not by folder) -- keeps
# small curated project files like data/raw/kinases/kinase_90_list.txt
*.pkl
*.h5ad
data/raw/**/*.csv
data/raw/**/*.tsv
data/raw/**/*.maf
data/raw/**/*.maf.gz
data/processed/**/*.npz
data/processed/**/*.csv
cptac-proteomics-validation/data/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model checkpoints / training artifacts
outputs/**/*.pt
outputs/**/*.pth

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# =====================================================================
# Added: scratch documents, decks, and duplicate scripts.
# Built from this repo's actual untracked-files history, not a generic
# template. Explicit paths (not wildcards like "*.docx") because docs/
# legitimately contains tracked reports (Ranking_Methodology_Report.docx,
# Session_Troubleshooting_Report.docx, etc.) that must stay tracked.
#
# IMPORTANT -- deliberately NOT listed below, despite looking like scratch:
#   src/subtyping/reconstruct_cohort_funnel.py
#     -> cited by name in the manuscript's Availability of Data and
#        Materials statement. Must remain tracked.
#   src/subtyping/cohort_funnel_audit/
#   src/subtyping/cohort_funnel_audit_hypothesisA/
#   src/subtyping/cohort_funnel_audit_hypothesisB/
#     -> very likely the sensitivity-analysis outputs the manuscript's
#        Supplementary Methods states are "available through the Data
#        and Code Availability resources." Confirm before ever ignoring.
#   src/subtyping/build_fig2_regenerated.py
#     -> likely the real script generating the manuscript's Figure 2.
#
# To intentionally commit something matched below anyway: git add -f <path>
# =====================================================================

