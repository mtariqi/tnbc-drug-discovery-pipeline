# Run outputs -- patient-level regimen tables, discovery results,
# exported JSON/CSV, charts. Derived from real patient data (TCGA MAF /
# clinical files); kept out of git history as a default habit rather than
# decided case-by-case.
outputs/*
!outputs/.gitkeep

# OS cruft
.DS_Store
