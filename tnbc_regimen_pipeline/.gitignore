# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
venv/
.env
.pytest_cache/

# Pipeline cache (joblib.Memory-backed PubMed/DGIdb response cache --
# regeneratable, not source)
.pipeline_cache/
